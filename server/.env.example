# Copy this file to .env and replace the example values.
NODE_ENV=development
PORT=5002
MONGODB_URI=mongodb://127.0.0.1:27017/mern_login_dashboard
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5175
# In production, use HTTPS and set CLIENT_ORIGIN to your exact frontend origin.

# Email verification (Resend). In development, failed sends print the code in the server terminal.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
